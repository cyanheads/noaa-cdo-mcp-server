{
  "name": "noaa-cdo-mcp-server",
  "version": "0.1.14",
  "description": "Search NOAA CDO stations and datasets, fetch historical weather observations via MCP. STDIO or Streamable HTTP.",
  "author": {
    "name": "cyanheads"
  },
  "homepage": "https://github.com/cyanheads/noaa-cdo-mcp-server#readme",
  "repository": "https://github.com/cyanheads/noaa-cdo-mcp-server",
  "license": "Apache-2.0",
  "mcpServers": {
    "noaa-cdo-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/noaa-cdo-mcp-server"],
      "env": {
        "NOAA_CDO_TOKEN": "your-noaa-cdo-token",
        "MCP_TRANSPORT_TYPE": "stdio"
      }
    }
  }
}
